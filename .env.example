# Copy to .env and fill in. All values are optional.
#
# If ANTHROPIC_API_KEY is left empty, the /ask endpoint still works: it returns
# the top retrieved runbook chunks instead of an LLM-synthesized answer.
ANTHROPIC_API_KEY=

# Model used for answer synthesis (default: claude-sonnet-5).
# CLAUDE_MODEL=claude-sonnet-5

# Number of chunks retrieved per question when the request omits top_k.
# DEFAULT_TOP_K=3
